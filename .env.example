# O .env tem senha e NUNCA deve ir para o GitHub.

# Endereço do banco: postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
SENTINEL_DATABASE_URL=

# Banco separado só para os testes
SENTINEL_TEST_DATABASE_URL=

# Chave que assina os tokens de login (crie uma com: python -c "import secrets; print(secrets.token_hex(32))")
SENTINEL_CHAVE_SECRETA=