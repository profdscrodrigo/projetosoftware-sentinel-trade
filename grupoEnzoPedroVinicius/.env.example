# Configurações do SentinelTrade.
# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" não deve ser enviado ao Git (está no .gitignore).

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentineltrade
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Segurança
JWT_SECRET=chave_secreta_aqui
MFA_MAX_TENTATIVAS=5

# Provedor de cotações (simulado)
COTACOES_URL=http://localhost:9001
COTACOES_API_KEY=sua_chave

# Bolsa simulada
BOLSA_URL=http://localhost:9002
BOLSA_API_KEY=sua_chave
BOLSA_TIMEOUT_MS=2000
BOLSA_MAX_TENTATIVAS=3

# Fila de mensagens
FILA_URL=amqp://localhost:5672
