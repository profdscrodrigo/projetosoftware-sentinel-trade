        <mxCell id="c32" value="«include»" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#b85450;fontSize=10;fontColor=#9a2a26;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="1" edge="1">
