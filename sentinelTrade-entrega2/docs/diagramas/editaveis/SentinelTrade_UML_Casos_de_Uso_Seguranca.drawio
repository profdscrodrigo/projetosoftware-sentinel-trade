            <mxPoint x="820" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c36" value="«include»" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#b85450;fontSize=10;fontColor=#9a2a26;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="510" as="sourcePoint" />
            <mxPoint x="820" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c37" value="«include»" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#b85450;fontSize=10;fontColor=#9a2a26;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint x="570" y="600" as="sourcePoint" />
            <mxPoint x="820" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c38" value="«include»" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#b85450;fontSize=10;fontColor=#9a2a26;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint x="570" y="690" as="sourcePoint" />
            <mxPoint x="820" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c39" value="«include»" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#b85450;fontSize=10;fontColor=#9a2a26;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint x="570" y="800" as="sourcePoint" />
            <mxPoint x="820" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;«secrecy»&lt;/b&gt; Senhas guardadas só como hash BCrypt; HTTPS em produção; cookie de sessão HttpOnly e SameSite; nenhuma senha ou chave no Git (.env fora do repositório).&lt;br&gt;&lt;i&gt;Código: SegurancaConfig, application.properties&lt;/i&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1240" y="92" width="400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#999999;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="138" as="sourcePoint" />
            <mxPoint x="1080" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;«inputValidation»&lt;/b&gt; Cada campo tem formato, tamanho e faixa (@Pattern, @Positive, @Digits); só aceita valores conhecidos (COMPRA/VENDA, ativos cadastrados); SQL sempre com &lt;b&gt;?&lt;/b&gt; (nunca concatena); telas codificam a saída (Thymeleaf).&lt;br&gt;&lt;i&gt;Código: OrdemForm, repositórios&lt;/i&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1240" y="322" width="400" height="106" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#999999;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="375" as="sourcePoint" />
            <mxPoint x="1080" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;«leastPrivilege»&lt;/b&gt; Cada perfil só abre as próprias páginas (/investidor, /admin, /risco), conferido no servidor em toda requisição; investidor só vê as próprias ordens.&lt;br&gt;&lt;i&gt;Código: SegurancaConfig, OrdemService&lt;/i&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1240" y="684" width="400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#999999;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="730" as="sourcePoint" />
            <mxPoint x="1080" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;«audit»&lt;/b&gt; Registra quem, quando, o quê e o resultado; nunca grava senhas ou códigos; o banco bloqueia alteração e exclusão dos registros.&lt;br&gt;&lt;i&gt;Código: AuditoriaService, gatilhos do schema.sql&lt;/i&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1240" y="459" width="400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#999999;fontFamily=Helvetica;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="505" as="sourcePoint" />
            <mxPoint x="1080" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Estereótipos nos casos de uso do investidor e do administrador&lt;/b&gt;&lt;br&gt;• &lt;b&gt;«secureAuthentication»&lt;/b&gt;: senha + código de 6 dígitos (vale 5 min, 3 tentativas); 3 senhas erradas bloqueiam por 15 min; a mensagem de erro não diz qual dado errou. &lt;i&gt;AutenticacaoService, DesafioMfa&lt;/i&gt;&lt;br&gt;• &lt;b&gt;«integrity»&lt;/b&gt;: saldo, carteira, limites e mercado são conferidos no servidor; o identificador único impede ordem duplicada; estados finais travados. &lt;i&gt;ValidadorOrdem, OrdemService&lt;/i&gt;&lt;br&gt;• &lt;b&gt;«availability»&lt;/b&gt;: se a Bolsa cair, a ordem vira FALHA sem mexer na carteira e é reenviada depois com o mesmo id. &lt;i&gt;OrdemService.recuperarFalhas()&lt;/i&gt;&lt;br&gt;• &lt;b&gt;«DevSecOps»&lt;/b&gt;: a cada envio ao GitHub a esteira roda testes, Trivy (dependências e segredos) e Semgrep (código). &lt;i&gt;.github/workflows/devsecops.yml&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="940" width="1610" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;Como ler:&lt;/b&gt; azul = o que o usuário faz · vermelho = proteção que o sistema aplica · «include» = sempre acontece junto · nota amarela = como a proteção foi feita e em qual arquivo." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="1060" width="1610" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
