<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.17 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36" version="24.7.17">
  <diagram id="d1" name="UML Casos de Uso com Seguranca (UMLsec)">
    <mxGraphModel dx="-859" dy="-291" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="&lt;b style=&#39;font-size:20px&#39;&gt;SentinelTrade — Casos de Uso com Notação de Segurança (UMLsec)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px;color:#555&#39;&gt;Quem usa o sistema, para quê, e qual proteção de segurança vale em cada caso · cada nota diz onde isso está no código&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="10" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;i&gt;«secure»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Sistema SentinelTrade&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#333333;strokeWidth=2;verticalAlign=top;fontSize=14;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="290" y="75" width="820" height="840" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Autenticar-se com MFA&lt;br&gt;&lt;i&gt;«secureAuthentication»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="110" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Consultar carteira e cotações" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="200" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Enviar ordem de compra ou venda&lt;br&gt;&lt;i&gt;«integrity»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="290" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Alterar preço ou cancelar ordem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="380" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Recuperar ordens com falha&lt;br&gt;&lt;i&gt;«availability»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="480" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Gerenciar ativos e cotações" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="570" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Consultar auditoria" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="660" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Ajustar limites de risco" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="320" y="770" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Proteger dados&lt;br&gt;&lt;i&gt;«secrecy»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="820" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="Validar e sanitizar entradas&lt;br&gt;&lt;i&gt;«inputValidation»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="820" y="345" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Registrar auditoria&lt;br&gt;&lt;i&gt;«audit»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="820" y="475" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Autorizar por perfil&lt;br&gt;&lt;i&gt;«leastPrivilege»&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="820" y="700" width="260" height="60" as="geometry" />
        </mxCell>
