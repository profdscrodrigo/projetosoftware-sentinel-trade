
# SentinelTrade — variáveis de ambiente necessárias

# Aplicação web (Spring Boot)
APP_PORT=
APP_PERFIL=

# Banco de dados SQLite (caminho do arquivo .db)
DB_PATH=

# Bolsa/Corretora simulada e provedor de cotações
BOLSA_SIMULADA_URL=
COTACOES_URL=
BOLSA_TIMEOUT_SEGUNDOS=
BOLSA_MAX_TENTATIVAS=

# Segurança (RNF-01)
MFA_ISSUER=
MFA_SECRET_KEY=
SESSAO_SEGREDO=
SESSAO_MINUTOS_EXPIRACAO=

# Notificações (RF-12)
NOTIFICACAO_REMETENTE=

# Cookie de sessão só por HTTPS (true em produção; false no computador local)
COOKIE_SEGURO=
