  ana [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>AnalistaRisco</B></TD></TR></TABLE>>];
  ses [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Sessao</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado<BR ALIGN="LEFT"/>expiraEm<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  con [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Conta</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">saldoDisponivel<BR ALIGN="LEFT"/>saldoBloqueado<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  pos [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Posicao</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">quantidade<BR ALIGN="LEFT"/>quantidadeBloqueada<BR ALIGN="LEFT"/>custoTotal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ati [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Ativo</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ticker<BR ALIGN="LEFT"/>nome<BR ALIGN="LEFT"/>tipo<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  cot [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Cotacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">preco<BR ALIGN="LEFT"/>fechamentoAnterior<BR ALIGN="LEFT"/>instante<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ord [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><I>Ordem</I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lado<BR ALIGN="LEFT"/>tipo (limite | mercado)<BR ALIGN="LEFT"/>quantidade<BR ALIGN="LEFT"/>precoLimite<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/>chaveIdempotencia<BR ALIGN="LEFT"/>substituiOrdemId<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  oc [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>OrdemCompra</B></TD></TR></TABLE>>];
  ov [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>OrdemVenda</B></TD></TR></TABLE>>];
  exe [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Execucao</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">idExecucao<BR ALIGN="LEFT"/>quantidade<BR ALIGN="LEFT"/>preco<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  lim [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>LimiteRisco</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">porOrdem<BR ALIGN="LEFT"/>diario<BR ALIGN="LEFT"/>confirmacao<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  not [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Notificacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo<BR ALIGN="LEFT"/>mensagem<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  aud [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>EventoAuditoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">seq<BR ALIGN="LEFT"/>tipo<BR ALIGN="LEFT"/>hash<BR ALIGN="LEFT"/>hashAnterior<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
