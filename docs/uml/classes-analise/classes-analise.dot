  cli [shape=plain, label=<<TABLE BORDER="1" COLOR="#B07A00" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4D6"><TR><TD><FONT POINT-SIZE="9"><I>&#171;control&#187;</I></FONT></TD></TR><TR><TD><B>ControleLiquidacao</B></TD></TR></TABLE>>];
  cco [shape=plain, label=<<TABLE BORDER="1" COLOR="#B07A00" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4D6"><TR><TD><FONT POINT-SIZE="9"><I>&#171;control&#187;</I></FONT></TD></TR><TR><TD><B>ControleCotacoes</B></TD></TR></TABLE>>];
