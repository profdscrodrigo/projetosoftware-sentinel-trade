  cau2 [shape=plain, label=<<TABLE BORDER="1" COLOR="#B07A00" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4D6"><TR><TD><FONT POINT-SIZE="9"><I>&#171;control&#187;</I></FONT></TD></TR><TR><TD><B>ControleAuditoria</B></TD></TR></TABLE>>];
 }
 subgraph cluster_e { label="ENTIDADE (entity)"; style=dashed; color="#5E9E5E"; fontsize=14;
  usu [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome<BR ALIGN="LEFT"/>email<BR ALIGN="LEFT"/>papel<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  inv [shape=plain, label=<<TABLE BORDER="1" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E7F6E7"><TR><TD><FONT POINT-SIZE="9"><I>&#171;entity&#187;</I></FONT></TD></TR><TR><TD><B>Investidor</B></TD></TR></TABLE>>];
