digraph analise { rankdir=LR; splines=true; nodesep=0.25; ranksep=1.1; fontname="Helvetica"; labelloc=t; fontsize=22;
 label="Diagrama de Classes de Análise — SentinelTrade (fronteira · controle · entidade)\n ";
 node [fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=9, color="#444444"];
 subgraph cluster_f { label="FRONTEIRA (boundary)"; style=dashed; color="#7A9CC6"; fontsize=14;
  tl [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaLogin</B></TD></TR></TABLE>>];
  to [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaOrdem (console e web)</B></TD></TR></TABLE>>];
  tc [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaCarteira</B></TD></TR></TABLE>>];
  tcot [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaCotacoes</B></TD></TR></TABLE>>];
  ta [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaAdministracao</B></TD></TR></TABLE>>];
  tr [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>TelaRisco</B></TD></TR></TABLE>>];
  ic [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>InterfaceCorretora</B></TD></TR></TABLE>>];
  in [shape=plain, label=<<TABLE BORDER="1" COLOR="#2B4C7E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F1FF"><TR><TD><FONT POINT-SIZE="9"><I>&#171;boundary&#187;</I></FONT></TD></TR><TR><TD><B>InterfaceNotificacao</B></TD></TR></TABLE>>];
 }
